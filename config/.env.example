# =====================================================================
# END-TO-END INTERVIEW AGENT — environment template
# Copy to the project root as `.env` and fill in real values.
# NEVER commit the real .env.
# =====================================================================

APP_ENV=development
APP_NAME="End-to-End Interview Agent"
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Public base URL of the frontend (used for cookies/links)
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL (structured source of truth) ---
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interview_agent
DATABASE_URL=postgresql+psycopg://interview:change-me@postgres:5432/interview_agent

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# --- LLM ---
# grok = xAI Grok (key starts with xai-), groq = Groq (key starts with gsk_), gemini = optional legacy
LLM_PROVIDER=grok
# Create a key at https://console.x.ai  (starts with "xai-")
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
# Grok 4.x always reasons: low = fastest. Use none for a model that rejects the setting.
XAI_REASONING_EFFORT=low
# Groq (https://console.groq.com) — very fast open models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# low/medium/high for gpt-oss models; none for llama models
GROQ_REASONING_EFFORT=low
# Per-call timeout and extra attempts (kept small so a live interview never stalls)
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_RATE_LIMIT_PER_MINUTE=60

# --- Optional legacy Gemini path (LLM_PROVIDER=gemini; also pip install -r requirements-gemini.txt) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_USE_VERTEX=false
GEMINI_FALLBACK_MODELS=

# --- Embeddings ---
# local = MiniLM model running inside the container (no key needed; xAI has no embeddings API)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_VERSION=1
EMBEDDING_DIMENSIONS=384

# --- MinIO (blob storage, private buckets) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=interview-minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=interview-agent
MINIO_SECURE=false
# Optional: hostname the BROWSER uses to reach MinIO for presigned URLs
MINIO_PUBLIC_ENDPOINT=localhost:9000
PRESIGNED_URL_EXPIRY_SECONDS=300

# --- Redis (Celery broker + rate limiting + pub/sub; NOT a database) ---
REDIS_URL=redis://redis:6379/0

# --- ChromaDB (derived vector index) ---
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=knowledge_chunks

# --- Speech ---
STT_PROVIDER=faster_whisper
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# 1 = fast greedy decoding on CPU (5 is slower, barely more accurate)
STT_BEAM_SIZE=1
# 0 = use all CPU cores per transcription
STT_CPU_THREADS=0
# Hard time limits for server-side speech. A stuck model can no longer freeze a turn: after the limit the
# candidate is asked to answer again or type. The browser normally sends its own transcript, which skips server STT.
STT_TIMEOUT_SECONDS=90
TTS_TIMEOUT_SECONDS=20
TTS_PROVIDER=piper
# Path to a Piper .onnx voice model inside the worker container
PIPER_VOICE_PATH=/models/piper/en_US-lessac-medium.onnx

# --- WebRTC ---
# Comma-separated ICE servers for browser peer connections
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302

# --- Uploads ---
MAX_UPLOAD_MB=20
MAX_MEDIA_UPLOAD_MB=100

# --- Frontend (public, non-secret) ---
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_WS_BASE=ws://localhost:8000

# ---- Live interview turns: answer -> evaluation -> profile update -> next question (strictly in this order)
# Evaluation attempts per answer before it is marked evaluation_failed (the candidate gets a Retry button).
# No score is ever invented and the next question is never chosen without the evaluation.
TURN_EVAL_ATTEMPTS=3
# A turn with no progress for this long (worker crash, lost task) is re-queued, at most twice.
TURN_STUCK_SECONDS=120

# ---- Adaptive policy cut-offs (rubric criteria are scored 0-10; see backend/app/domain/adaptive.py)
# Evaluator confidence below this = answer too vague to judge -> ask a clarifying question at the same difficulty.
ADAPTIVE_CLARIFY_CONFIDENCE=0.5
# Correctness at/above this with concepts missing -> targeted follow-up on the missing concept.
ADAPTIVE_GAP_MIN_CORRECTNESS=6.0
# Correctness and completeness at/above these count as strong for difficulty even if the answer was short,
# so a concise but correct answer is not held back.
ADAPTIVE_CONCISE_CORRECT_MIN=8.0
ADAPTIVE_CONCISE_COMPLETE_MIN=7.0
