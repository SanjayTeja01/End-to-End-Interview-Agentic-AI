#!/usr/bin/env bash
# Blocks a commit that would add a secrets file or anything that looks like an API key / private key.
# Enable once per clone:  git config core.hooksPath .githooks
set -u

fail=0
files=$(git diff --cached --name-only --diff-filter=ACMR)

# 1) Secret files, even if someone forces them past .gitignore with `git add -f`
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    .env.example|config/.env.example) ;;
    .env|.env.*|*/.env|*/.env.*|*.env|*.pem|*.key|*.p12|*.pfx|*id_rsa*|*id_ed25519*|*credentials*.json|*service-account*.json|*.tgz|*.tar.gz|*.zip|backup-*/*)
      echo "BLOCKED: $f must not be committed"; fail=1 ;;
  esac
done <<< "$files"

# 2) Key-shaped strings in the staged changes
pattern='gsk_[A-Za-z0-9]{20,}|xai-[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}|sk-[A-Za-z0-9_-]{20,}|hf_[A-Za-z0-9]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
hits=$(git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+[^+]' | grep -nE "$pattern")
if [ -n "$hits" ]; then
  echo "BLOCKED: staged changes contain what looks like an API key or private key:"
  echo "$hits" | sed -E 's/(gsk_|xai-|AIza|sk-|hf_|gh[pousr]_|AKIA|xox[baprs]-)[A-Za-z0-9_-]+/\1********/g' | cut -c1-160
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "Commit stopped. Move the value into .env (which is ignored) and unstage the file: git restore --staged <file>"
  exit 1
fi
exit 0
